# Required. On Vercel use the Supabase Session pooler URI:
# host *.pooler.supabase.com, port 5432, database postgres.
# Do not use 127.0.0.1 in production.
# Do not use the direct db.[project-ref].supabase.co host: it is often IPv6-only and Vercel cannot reach it.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Required in production. Signs the session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Required in production so uploaded files persist. The service role key is server-only.
# Never prefix SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases. Used only when the NEXT_PUBLIC_ names above are empty.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Development only. Leave unset in production.
# Shows email verification and password-reset links on screen when SMTP is not configured.
# ANDALLO_DEV_LINKS=1
# Shows the phone OTP on screen when an SMS provider is not configured.
# ANDALLO_DEV_OTP=1

# Optional. When set, GET /api/cron/expire requires Authorization: Bearer <secret>.
CRON_SECRET=

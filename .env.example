# Local PostgreSQL. On Vercel, use the Supabase pooler URL for a role that is not a superuser.
DATABASE_URL=postgres://andallo_app:change-me@127.0.0.1:5432/andallo

# Required in production. Signs the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Optional Supabase. When these are set, uploads and realtime use Supabase.
# Never expose the service role key to the browser. Only SUPABASE_SERVICE_ROLE_KEY stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development only. Do not enable in production.
# Shows email verification and password-reset links on screen when SMTP is not configured.
ANDALLO_DEV_LINKS=1
# Shows the phone OTP on screen when an SMS provider is not configured.
ANDALLO_DEV_OTP=1

# Protects /api/cron/expire when set.
CRON_SECRET=

# Copy to .env and adjust. All values are optional.

# HTTP port and bind address
PORT=3000
HOST=0.0.0.0

# Path to the JSON database (defaults to data/db.json)
# DB_FILE=data/db.json

# Signs login tokens. Set a long random value in production (Vercel → Settings → Environment Variables).
# If empty, the app uses a built-in demo secret.
SESSION_SECRET=

# WhatsApp Cloud API — leave empty to keep notifications in-app only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
